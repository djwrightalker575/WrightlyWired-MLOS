#!/usr/bin/env python3
import json, sys, urllib.request
base='http://127.0.0.1:8000'
cmd=sys.argv[1] if len(sys.argv)>1 else ''
if cmd=='run':
    intent=' '.join(sys.argv[2:])
    req=urllib.request.Request(base+'/api/runs',data=json.dumps({'intent':intent}).encode(),headers={'Content-Type':'application/json'})
    print(urllib.request.urlopen(req).read().decode())
elif cmd=='runs':
    print(urllib.request.urlopen(base+'/api/runs').read().decode())
elif cmd=='run-status':
    rid=sys.argv[2]
    print(urllib.request.urlopen(base+f'/api/runs/{rid}').read().decode())
else:
    print('usage: mlos run|runs|run-status')
